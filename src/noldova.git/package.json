{
  "name": "@noldova/git",
  "version": "0.0.4",
  "description": "The Git module for apps on Noldova Desktop: a folder's Git state and changes, and agent tools that run Git through permission requests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/git.git",
    "directory": "src/noldova.git"
  },
  "homepage": "https://github.com/noldova-com/git#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/git/issues"
  },
  "exports": {
    "./runtime": "./src/api/index.ts",
    "./window": "./src/api/window.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "module.json",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noldova/git.protocol": "0.0.4",
    "@noldova/git.window": "0.0.4"
  },
  "peerDependencies": {
    "@noldova/desktop.protocol": ">=0.0.10 <0.1.0",
    "@noldova/desktop.runtime": ">=0.0.10 <0.1.0",
    "@noldova/context.exceptions": ">=0.0.9 <0.1.0",
    "@noldova/context.json": ">=0.0.9 <0.1.0"
  }
}
