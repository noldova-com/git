{
  "id": "git",
  "version": "0.0.9",
  "displayName": "Git",
  "description": "Shows a folder's Git state, stages, commits, switches branches, pushes, pulls, cherry-picks and reverts, and lets AI agents stage, commit, branch, push and pull through permission requests.",
  "parts": ["runtime", "window"],
  "dependencies": {},
  "optionalDependencies": { "checkpoints": "0.0.4", "terminal": "0.0.8" },
  "noldovaDesktop": ">=0.0.17 <0.1.0",
  "contributes": {
    "methods": [
      "git.status",
      "git.diff",
      "git.diffTotals",
      "git.branches",
      "git.mergedBranches",
      "git.remoteTracks",
      "git.log",
      "git.graph",
      "git.messageReferences",
      "git.worktrees",
      "git.repositoryItems",
      "git.commitDetail",
      "git.commitSignature",
      "git.commitSigning",
      "git.pullHooks",
      "git.avatar",
      "git.scanRepositories",
      "git.watch",
      "git.unwatch",
      "git.stage",
      "git.unstage",
      "git.discard",
      "git.createBranch",
      "git.switchBranch",
      "git.commit",
      "git.push",
      "git.pull",
      "git.cherryPick",
      "git.revert",
      "git.createBranchAt",
      "git.renameBranch",
      "git.deleteBranch",
      "git.createTag",
      "git.deleteTag",
      "git.stageLines",
      "git.unstageLines",
      "git.amend",
      "git.journal",
      "git.commandLog",
      "git.undo",
      "git.reset",
      "git.undoCommit",
      "git.forcePush",
      "git.conflict",
      "git.resolveConflict",
      "git.markerCheck",
      "git.continueOperation",
      "git.abortOperation",
      "git.predict",
      "git.rebasePlan",
      "git.rebaseCheck",
      "git.rebase",
      "git.stash",
      "git.merge",
      "git.fetch"
    ],
    "events": ["git.changed"],
    "views": ["git.view", "git.repository", "git.workspaces", "git.commands", "git.commitView", "git.conflictDetail", "git.rebasePreview", "git.workspaceAcross"],
    "documents": ["git.history", "git.conflicts", "git.interactiveRebase", "git.workspace"],
    "commands": ["git.openHistory", "git.openCommandLog", "git.openConflicts", "git.openWorkspace"],
    "statusBarItems": ["git.branch", "git.fetched", "git.lastCommand"],
    "tools": [
      "git_status",
      "git_diff",
      "git_log",
      "git_branches",
      "git_stage",
      "git_unstage",
      "git_create_branch",
      "git_switch_branch",
      "git_commit",
      "git_push",
      "git_pull"
    ],
    "settingsPages": ["git.accounts"],
    "settings": ["git.gravatar", "git.undoHistory"]
  }
}
