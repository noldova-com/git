{
  "id": "git-github",
  "version": "0.0.9",
  "displayName": "GitHub",
  "description": "Signs in to GitHub, shows its issues, pull requests and checks, and opens pull requests, and lets AI agents do the same through permission requests.",
  "parts": ["runtime", "window"],
  "dependencies": { "git": "0.0.9" },
  "noldovaDesktop": ">=0.0.18 <0.1.0",
  "contributes": {
    "methods": ["git-github.readSignIn", "git-github.startSignIn", "git-github.cancelSignIn", "git-github.signOut", "git-github.readReference",
      "git-github.readBranchPullRequest", "git-github.createPullRequest",
      "git-github.readAuthorAvatar", "git-github.readPullRequests", "git-github.readReviewRequests",
      "git-github.readCommitComments", "git-github.readPullRequest", "git-github.readPullRequestThreads", "git-github.readCommitPullRequest",
      "git-github.readAccounts", "git-github.addAccount", "git-github.readRepositoryAccount", "git-github.pickAccount",
      "git-github.useFolder"],
    "events": ["git-github.signInChanged", "git-github.accountsChanged"],
    "tools": ["git_github_read", "git_github_pr_checks", "git_github_pr_create"]
  }
}
