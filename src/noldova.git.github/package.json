{
  "name": "@noldova/git.github",
  "version": "0.0.2",
  "description": "The GitHub module for apps on Noldova Desktop: the sign-in to GitHub, its issues, pull requests and checks, and agent tools that use GitHub through permission requests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/git.git",
    "directory": "src/noldova.git.github"
  },
  "homepage": "https://github.com/noldova-com/git#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/git/issues"
  },
  "exports": {
    "./runtime": "./src/api/index.ts",
    "./window": "./src/api/window.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "module.json",
    "settings.json",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noldova/git.github.protocol": "0.0.2",
    "@noldova/git.protocol": "0.0.2",
    "@noldova/git.github.window": "0.0.2",
    "@noldova/git.hosting.protocol": "0.0.2"
  },
  "peerDependencies": {
    "@noldova/desktop.protocol": ">=0.0.4 <0.1.0",
    "@noldova/desktop.runtime": ">=0.0.4 <0.1.0",
    "@noldova/context.exceptions": ">=0.0.7 <0.1.0",
    "@noldova/context.json": ">=0.0.7 <0.1.0"
  }
}
