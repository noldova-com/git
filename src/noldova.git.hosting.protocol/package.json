{
  "name": "@noldova/git.hosting.protocol",
  "version": "0.0.8",
  "description": "The hosting protocol that each of Git's host modules implements: a reference to an issue or pull request, the item and its checks, a branch's pull request, a pull request draft, and the sign-in's account and device code.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/git.git",
    "directory": "src/noldova.git.hosting.protocol"
  },
  "homepage": "https://github.com/noldova-com/git#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/git/issues"
  },
  "exports": {
    ".": "./src/api/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.js.map",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@noldova/context.core": ">=0.0.18 <0.1.0",
    "@noldova/context.exceptions": ">=0.0.18 <0.1.0",
    "@noldova/context.json": ">=0.0.12 <0.1.0"
  }
}
